#!/bin/sh
# claude smart-router wrapper (Git Bash / POSIX sh), portable.
# gateway (8787) online -> launch with isolated profile (claude-profile)
# gateway offline       -> launch plain, use default ~/.claude config
if curl -s -m 2 --noproxy '*' http://127.0.0.1:8787/health >/dev/null 2>&1; then
  CLAUDE_CONFIG_DIR="$(cd "$(dirname "$0")" && pwd)/claude-profile"
  export CLAUDE_CONFIG_DIR
fi

# Prefer the native-installer binary (Windows), fall back to `claude` on
# PATH (npm installs, or macOS/Linux native installs).
if [ -x "$HOME/.local/bin/claude.exe" ]; then
  exec "$HOME/.local/bin/claude.exe" "$@"
fi
exec claude "$@"
